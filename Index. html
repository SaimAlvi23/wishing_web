<!DOCTYPE html>

<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Eid Mubarak</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<style>

    body {

        font-family: Arial, sans-serif;

        margin: 0;

        padding: 0;

    }



    /* START PAGE */

    #start-page {

        display: flex;

        justify-content: center;

        align-items: center;

        height: 100vh;

        background: #1a1a1a;

        color: white;

        flex-direction: column;

        text-align: center;

        background-size: cover;

        background-position: center;

        background-repeat: no-repeat;

    }



    #eid-page {

        display: none;

    }



    #eid-page .overlay {

        min-height: 100vh;

        background-size: cover;

        background-position: center;

        background-repeat: no-repeat;

        color: white;

    }



    .eid-title {

        font-weight: bold;

        color: #FFD700;

        text-shadow: 0 0 10px #fff, 0 0 30px #FFD700;

    }



    .section-box {

        background: rgba(0, 0, 0, 0.6);

        border-radius: 15px;

        padding: 30px;

    }



    .navbar .navbar-brand {

        font-weight: bold;

        font-size: 1.25rem;

        color: #FFD700;

    }



    /* Responsive Fonts */

    @media(max-width: 768px){

        .eid-title {

            font-size: 50px;

        }

        #start-page h2 {

            font-size: 1.5rem;

        }

        #start-page input {

            max-width: 90%;

        }

        .section-box {

            padding: 20px;

        }

    }



    @media(max-width: 480px){

        .eid-title {

            font-size: 35px;

        }

        #start-page h2 {

            font-size: 1.2rem;

        }

        .btn-lg {

            font-size: 1rem;

            padding: 0.5rem 1rem;

        }

    }

</style>

</head>

<body>



<!-- START PAGE -->

<div id="start-page" style="background-image: url('images/3.jpeg');">

    <h2 style="color: #ffd900 !important;">Welcome! 🌙</h2>

    <p style="color:cornsilk !important;">Enter your name to get Wishes</p>

    <input type="text" id="username-input" class="form-control mb-3" placeholder="Your Name" style="max-width:300px;">

    <button class="btn btn-warning btn-lg" onclick="startEid()">Ready?</button>

</div>



<!-- EID PAGE -->

<div id="eid-page">

    <div class="overlay" style="background: url('https://png.pngtree.com/thumb_back/fw800/background/20260110/pngtree-ramadan-mubarak-night-sky-with-mosque-silhouette-image_21064443.webp');">

        <nav class="navbar navbar-expand-lg navbar-dark bg-dark bg-opacity-75">

            <div class="container">

                <a class="navbar-brand">🌙 Eid</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse" id="menu">

                    <ul class="navbar-nav ms-auto">

                        <li class="nav-item"><a class="nav-link" href="#home">Home</a></li>

                        <li class="nav-item"><a class="nav-link" href="#wishes">Eid Wishes</a></li>

                        <li class="nav-item"><a class="nav-link" href="#message">Special Message</a></li>

                    </ul>

                </div>

            </div>

        </nav>



        <section id="home" class="d-flex align-items-center text-center" style="min-height:90vh">

            <div class="container">

                <div class="mb-4 fs-1">⭐ 🌙 🏮 ⭐</div>

                <h1 class="eid-title display-1">Eid Mubarak</h1>

                <h3 style="text-shadow: 0 0 10px #fff, 0 0 30px #FFD700;" class="mt-3 text-warning"><b>From <span>Saim Alvi</span></b></h3>

                <p class="mt-4 fs-5">✨ May Allah fill your life with happiness and blessings ✨</p>

                <div class="fs-1 mt-4">🎆 ⭐ 🌙 🏮 🎆</div>

                <a href="#wishes" class="btn btn-warning btn-lg mt-4">See Eid Wishes</a>

            </div>

        </section>



        <section id="wishes" class="py-5">

            <div class="container">

                <div class="section-box text-center">

                    <h2 class="text-warning mb-4">Eid Wishes 🤲</h2>

                    <div class="row">

                        <div class="col-md-4 col-12 mb-4">

                            <div class="card bg-dark text-light">

                                <div class="card-body">

                                    <h4>🌙 Happiness</h4>

                                    <p>May this Eid bring joy and happiness to your life.</p>

                                </div>

                            </div>

                        </div>

                        <div class="col-md-4 col-12 mb-4">

                            <div class="card bg-dark text-light">

                                <div class="card-body">

                                    <h4>🤲 Blessings</h4>

                                    <p>May Allah accept your prayers and bless your family.</p>

                                </div>

                            </div>

                        </div>

                        <div class="col-md-4 col-12 mb-4">

                            <div class="card bg-dark text-light">

                                <div class="card-body">

                                    <h4>💫 Success</h4>

                                    <p>May Allah fill your future with success.</p>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </section>



        <section id="message" class="pb-5">

            <div class="container">

                <div class="section-box text-center">

                    <h2 class="text-warning mb-4">Special Message 💌</h2>

                    <p class="fs-5">

                        Eid is a beautiful day of love, unity and gratitude.<br>

                        May Allah bring peace, prosperity and happiness into your life.<br><br>

                        <strong>Eid Mubarak!</strong>

                        <br><br>

                        <span id="user-name">Saim Alvi</span>

                    </p>

                    <div class="fs-1 mt-3">🏮 🌙 ⭐ 🎆</div>

                </div>

            </div>

        </section>



        <footer class="text-center pb-3">

            <p class="text-light">🌙 Eid Mubarak | Made by <span id="footer-name">Saim Alvi</span></p>

        </footer>

    </div>

</div>



<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>

function startEid() {

    const name = document.getElementById("username-input").value.trim();

    if(name === "") {

        alert("Please enter your name!");

        return;

    }

    document.getElementById("start-page").style.display = "none";

    document.getElementById("eid-page").style.display = "block";



    document.getElementById("user-name").innerText = name;

    document.getElementById("msg-name").innerText = name;

    document.getElementById("footer-name").innerText = name;

}

</script>

</body>

</html>
